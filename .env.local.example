# Supabase - see supabase/README (or the Dashboard: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Bypasses RLS. Server-only - never expose to the client,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the magic-link redirect URL (emailRedirectTo). Local dev:
# http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# HMAC secret for hashing requester IPs before they're written to
# sign_in_events - never store raw IPs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_IP_HASH_SECRET=

# Resend (transactional email - sign-in magic links, once wired into
# Supabase Auth's custom SMTP in P1 PR4)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio (SMS sign-in codes, once wired into Supabase Auth's custom SMS
# provider in P1 PR4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
