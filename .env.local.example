# Supabase - see supabase/README (or the Dashboard: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Bypasses RLS. Server-only - never expose to the client,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the magic-link redirect URL (emailRedirectTo). Local dev:
# http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# HMAC secret for hashing requester IPs before they're written to
# sign_in_events - never store raw IPs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_IP_HASH_SECRET=

# Resend (transactional email). Wired into Supabase Auth's custom SMTP
# as of P1 PR4 for sign-in magic links (RESEND_API_KEY doubles as the
# SMTP password - supabase/config.toml's auth.email.smtp.pass) AND used
# directly via the Resend SDK for non-auth transactional email as of P2
# PR5 (lib/referral/send-resume-email.ts - the intake cross-device
# resume link, which isn't a Supabase Auth flow).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio (SMS sign-in codes) - still pending, not wired into Supabase
# Auth's custom SMS provider yet.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Inngest (jobs, P4). Local dev only: INNGEST_DEV=1 tells the SDK to run
# in dev mode against the local Inngest Dev Server (`npx inngest-cli@latest dev`)
# instead of expecting real Inngest Cloud signing keys. Production needs
# INNGEST_SIGNING_KEY (and INNGEST_EVENT_KEY for inngest.send() calls) from
# a real Inngest account, which doesn't exist yet - same credential-gap
# state as Zoom/Twilio.
INNGEST_DEV=1

# Sentry (error tracking, P7b). Deliberately unset - no KinKeepers Sentry
# project exists yet (reusing another product's DSN would mix unrelated
# error data). PII scrubbing is built and unit-tested regardless
# (lib/observability/scrub-sentry-event.ts); Sentry.init with no dsn
# captures nothing, so this stays a no-op until a real project exists AND
# scrubbing is verified live against it. NEXT_PUBLIC_ is correct here -
# Sentry DSNs are meant to be public, not secret.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for source-map upload during build (org/project are
# hardcoded in next.config.ts - "brandlamb"/"kinkeepers", both unconfirmed
# guesses). Build succeeds without this; source maps just won't upload.
SENTRY_AUTH_TOKEN=
